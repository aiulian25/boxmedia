# BoxMedia configuration — copy to `.env` and fill in. NEVER commit the real .env.
# App-level secrets/infra live here (ruling #2). External-app (Radarr) connections
# are managed in the Settings UI and encrypted at rest — they do NOT belong here.

# --- Required ---

# Session secret. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters. The app refuses to start otherwise. It signs the
# per-session CSRF token every form carries, so changing it invalidates open forms.
BM_SESSION_SECRET=

# Absolute path to the AES-256-GCM key that encrypts stored Radarr API keys and
# backup archives. Generate once with:
#   python -m app.core.crypto genkey /secrets/boxmedia.key
# Keep this file OUTSIDE BM_DATA_DIR so backups can never contain their own key.
BM_ENCRYPTION_KEY_FILE=/secrets/boxmedia.key

# --- Optional (sane defaults shown) ---

# Where all runtime data lives (config, history, logs, poster cache, backups).
BM_DATA_DIR=/data

# WHERE ON THE HOST those live, and where the encryption key lives. Both compose
# services read these, so changing a path here changes it everywhere — editing the
# volume lines in docker-compose.yml instead is how one service ends up preparing a
# directory the other never mounts.
BM_DATA_PATH=./data
BM_SECRETS_PATH=./secrets

# Container-internal listen port (the app binds this). Reverse proxy fronts it.
BM_PORT=8686

# Host port docker-compose publishes on 127.0.0.1 (ruling #10). Change this if it
# collides with something already in use, then `docker compose up -d` — no rebuild.
BM_HOST_PORT=58546

# URL base for reverse-proxy sub-path deployments (e.g. /boxmedia). "" = served at root.
BM_URL_BASE=

# How long a signed-in session lasts at most, regardless of activity.
BM_SESSION_TTL_HOURS=12

# Sign out after this many minutes of inactivity. 0 disables the idle timeout (the
# absolute TTL above still applies). Activity slides the window, never past the TTL.
BM_SESSION_IDLE_MINUTES=0

# Login lockout, keyed by client IP (behind a proxy set BM_FORWARDED_ALLOW_IPS below so
# the real address is seen). Failures within the window trigger a lockout for the lock
# period. Tighten on an internet-exposed host, e.g. 3 / 600 / 3600.
BM_LOGIN_MAX_ATTEMPTS=5
BM_LOGIN_WINDOW_SECONDS=300
BM_LOGIN_LOCK_SECONDS=900

# Mark session cookies Secure (HTTPS-only). Keep true in production behind TLS.
# Set false ONLY for plain-HTTP dev access on a trusted LAN (else login won't stick).
BM_SECURE_COOKIES=true

# Verify TLS certificates on OUTBOUND calls to Radarr. Keep true. For a self-signed
# home Radarr, set BM_TLS_CA_FILE below instead of ever disabling this.
BM_OUTBOUND_TLS_VERIFY=true

# Optional CA bundle for outbound calls to a Radarr with a private/self-signed cert.
BM_TLS_CA_FILE=

# Comma-separated proxy IPs/CIDRs uvicorn trusts for X-Forwarded-* headers, so login
# rate-limiting sees the real client IP behind nginx/Traefik/Caddy/Pangolin/Cloudflare.
# (docker-compose maps this to uvicorn's FORWARDED_ALLOW_IPS.)
BM_FORWARDED_ALLOW_IPS=127.0.0.1

# Box-office chart source (Box Office Mojo weekly). Override only if the upstream
# URL changes, or to point at a fixture server for testing.
BM_BOXOFFICE_URL=https://www.boxofficemojo.com/weekly/
