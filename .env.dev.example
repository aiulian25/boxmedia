# BoxMedia development configuration — copy to `.env.dev` and fill in. NEVER commit it.
# Read only by docker-compose.dev.yml, which reads nothing from `.env`. Start with:
#   docker compose -f docker-compose.dev.yml --env-file .env.dev up -d --build
#
# Everything here is separate from production on purpose: its own data, its own key and
# its own session secret, so dev cannot see production's saved Radarr, Sonarr or media
# server connections. Do not point these paths at a production install: two running
# processes on one data directory overwrite each other's files, and both run the scheduler.

# Generate a fresh value, not production's:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BM_SESSION_SECRET=

# Where the dev stack keeps its files on the host. The key in BM_DEV_SECRETS_PATH is
# generated on first start.
BM_DEV_DATA_PATH=./data-dev
BM_DEV_SECRETS_PATH=./secrets-dev

# Host port, published on every interface. One past production's 58546.
BM_DEV_HOST_PORT=58547

# Which peers may set X-Forwarded-*. Nothing sits in front of this stack and the port is
# reachable off-host, so leave this narrow.
BM_DEV_FORWARDED_ALLOW_IPS=127.0.0.1

# Paths inside the container. These are the same as production's only because each stack
# mounts its own directories there.
BM_DATA_DIR=/data
BM_ENCRYPTION_KEY_FILE=/secrets/boxmedia.key

# The dev stack is plain HTTP, and a Secure cookie would never be sent back over it.
BM_SECURE_COOKIES=false
